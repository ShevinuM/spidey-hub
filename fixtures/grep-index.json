    "path": "src/components/Dashboard.svelte",
    "lines": [
      "<script lang=\"ts\">",
      "  import { menu } from \"../lib/menu\";",
      "  import { go } from \"../lib/router\";",
      "  let cursor = 0;",
      "  function onKey(e: KeyboardEvent) {",
      "    if (e.key === \"j\") cursor = (cursor + 1) % menu.length;",
      "    if (e.key === \"k\") cursor = (cursor + menu.length - 1) % menu.length;",
      "    if (e.key === \"Enter\") go(menu[cursor].id);",
      "  }",
      "</script>",
      "<svelte:window on:keydown={onKey} />",
      "<section class=\"m-auto w-[min(940px,100%)] border border-white/5 bg-pane/60 backdrop-blur-sm\">",
      "  {#each menu as item, i}",
      "    <button class:bg-alert-10={i === cursor} on:click={() => go(item.id)}>",
      "      <span>{item.glyph}</span><span>{item.label}</span><span>{item.key}</span>",
      "    </button>",
      "  {/each}",
      "</section>"
    ]
  },
  {
    "path": "src/components/GrepOverlay.svelte",
    "lines": [
      "<script lang=\"ts\">",
      "  import { index } from \"../lib/repo-index\";",
      "  import { search } from \"../lib/grep\";",
      "  let open = false;",
      "  let query = \"\";",
      "  let selected = 0;",
      "  $: hits = search(index, query);",
      "  $: preview = hits[selected] ?? null;",
      "  function onKey(e: KeyboardEvent) {",
      "    if (!open && e.key === \"/\") { open = true; e.preventDefault(); return; }",
      "    if (!open) return;",
      "    if (e.key === \"Escape\") { open = false; query = \"\"; selected = 0; }",
      "    if (e.key === \"ArrowDown\") selected = (selected + 1) % hits.length;",
      "    if (e.key === \"ArrowUp\") selected = (selected - 1 + hits.length) % hits.length;",
      "  }",
      "</script>",
      "<svelte:window on:keydown={onKey} />",
      "{#if open}",
      "  <div class=\"fixed inset-0 z-40 bg-pane/55 backdrop-blur-[2px]\">",
      "    <slot name=\"panes\" />",
      "  </div>",
      "{/if}"
    ]
  },
