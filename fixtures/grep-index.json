  {
    "path": "src/lib/grep.ts",
    "lines": [
      "import type { RepoFile, Hit } from \"./types\";",
      "",
      "const LIMIT = 400;",
      "",
      "export function search(files: RepoFile[], query: string): Hit[] {",
      "  const q = query.trim().toLowerCase();",
      "  if (!q) return files.map((f) => ({ path: f.path, line: 0, col: 0, text: f.lines.length + \" lines\" }));",
      "  const hits: Hit[] = [];",
      "  for (const file of files) {",
      "    file.lines.forEach((text, i) => {",
      "      const col = text.toLowerCase().indexOf(q);",
      "      if (col === -1 || hits.length >= LIMIT) return;",
      "      hits.push({ path: file.path, line: i + 1, col: col + 1, text });",
      "    });",
      "  }",
      "  return hits;",
      "}"
    ]
  },
