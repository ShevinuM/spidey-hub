---
// Global shell: fonts (via global.css's @fontsource imports) and Tailwind
// utilities, wired through the Astro/Vite pipeline — every route page wraps
// its Terminal.svelte island here to share one <head>.
//
// Mobile-block card: server-rendered (not a Svelte island — it needs no
// interactivity beyond a static link) and CSS-gated by a `(max-width:
// 899px), (pointer: coarse)` media query that hides `.terminal-root` and
// shows `.mobile-block` in its place; Terminal.svelte's `desktopMode`
// effect carries the matching JS guard.
//
// Copy comes from src/common/content/site.yaml's `mobileBlock`, read
// directly via getSite() since this file is the only consumer.
import "../styles/global.css";
import { getSite } from "../common/lib/data";

interface Props {
  // `title` is required: every one of the six route pages already passes
  // its own explicit title, so `astro check` fails loudly if a future page
  // ever forgets to pass one, instead of silently falling back to
  // hardcoded copy.
  title: string;
}

const { title } = Astro.props;
const { mobileBlock } = getSite();

// data-fixture-mode exposes the build's actual PORTFOLIO_FIXTURES mode at
// runtime, read by src/common/tests/ui/support/check-fixture-flag.ts's
// globalSetup to catch a stray server or wrong-mode dist/ answering on the
// shared webServer port.
const fixtureMode = process.env.PORTFOLIO_FIXTURES === "1";
---

<!doctype html>
<html lang="en" data-fixture-mode={String(fixtureMode)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="terminal-root" data-testid="terminal-root">
      <slot />
    </div>

    <div class="mobile-block" data-testid="mobile-block">
      <div class="mobile-block-card">
        <div class="mobile-block-heading" data-testid="mobile-block-heading">
          {mobileBlock.heading}
        </div>
        <div class="mobile-block-body" data-testid="mobile-block-body">
          {mobileBlock.body}
        </div>
        <a
          class="mobile-block-link"
          data-testid="mobile-block-link"
          href={mobileBlock.escapeHatchHref}
          target="_blank"
          rel="noreferrer"
        >
          {mobileBlock.escapeHatchText}
        </a>
      </div>
    </div>
  </body>
</html>

<style>
  /* Default (desktop + fine pointer, or any width >= 900px): the terminal
     renders, the card stays out of the DOM's visible flow entirely. */
  .mobile-block {
    display: none;
  }

  /* Triggers below 900px width OR coarse pointer (whichever
     fires first — an OR of two media features via a comma-separated
     list). No scaled-down layout, no hamburger, no attempt to reflow the
     terminal's own panes — the terminal subtree is removed from view
     entirely and replaced by this single centered card. */
  @media (max-width: 899px), (pointer: coarse) {
    .terminal-root {
      display: none;
    }
    .mobile-block {
      display: flex;
      position: fixed;
      inset: 0;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background:
        radial-gradient(rgba(196, 216, 232, 0.16) 1px, transparent 1px) 0 0 / 26px 26px,
        #0b0f14;
      font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    }
  }

  .mobile-block-card {
    width: min(360px, 100%);
    border: 1px solid #e0453c;
    border-radius: 4px;
    background: rgba(9, 13, 18, 0.85);
    padding: 20px 22px;
    text-align: center;
    color: #f4ece9;
  }

  .mobile-block-heading {
    color: #e0453c;
    letter-spacing: 0.06em;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .mobile-block-body {
    color: rgba(196, 216, 232, 0.78);
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 14px;
  }

  .mobile-block-link {
    display: inline-block;
    color: #5fc6b4;
    font-size: 13px;
    text-decoration: none;
  }
  .mobile-block-link:hover {
    color: #8fd0f5;
  }
</style>
