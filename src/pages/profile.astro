---
// Route: "/profile" — see src/pages/index.astro for the shared shape notes.
import Shell from "../layouts/Shell.astro";
import Terminal from "../components/Terminal.svelte";
import { getCollection } from "astro:content";
import { getSite, getDashboard, getTracker, getProfile, getBuilds, getPersonnel, getCompanies, getGrep, getHelp, getBoot, getCmdline } from "../lib/data";
import { getCommitsByRepo } from "../lib/commits";

const site = getSite();
const dashboard = getDashboard();
const tracker = getTracker();
const profile = getProfile();
const builds = getBuilds();
const personnel = getPersonnel();
const companies = getCompanies();
const grep = getGrep();
const help = getHelp();
const boot = getBoot();
const cmdline = getCmdline();
const projects = await getCollection("projects");
const personnelEntries = await getCollection("personnel");
const commitsByRepo = getCommitsByRepo(projects);
---

<Shell title="Profile — shevinum.dev">
  <Terminal
    client:load
    initialView="profile"
    {site}
    {dashboard}
    {tracker}
    {profile}
    {builds}
    {personnel}
    {companies}
    {grep}
    {help}
    {boot}
    {cmdline}
    {projects}
    {personnelEntries}
    {commitsByRepo}
  />
</Shell>
