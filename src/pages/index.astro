---
// Route: "/" — dashboard (home) view. All five route pages share this same
// shape (PLAN.md "Routing assumption"): load every data source + content
// collection in frontmatter, then SSR the single Terminal.svelte island
// with `initialView` so the matching view is in the static HTML with no
// client-side flash. Later view switches are client-side only (pushState).
import Shell from "../layouts/Shell.astro";
import Terminal from "../components/Terminal.svelte";
import { getCollection } from "astro:content";
import { getSite, getDashboard, getNotifications, getTracker, getProfile, getBuilds, getPersonnel, getCompanies, getGrep, getHelp, getBoot, getCmdline, getHelpSearch, getShell } from "../lib/data";
import { getCommitsByRepo } from "../lib/commits";

const site = getSite();
const dashboard = getDashboard();
const notifications = getNotifications();
const tracker = getTracker();
const profile = getProfile();
const builds = getBuilds();
const personnel = getPersonnel();
const companies = getCompanies();
const grep = getGrep();
const help = getHelp();
const boot = getBoot();
const cmdline = getCmdline();
const helpSearch = getHelpSearch();
const shell = getShell();
const projects = await getCollection("projects");
const personnelEntries = await getCollection("personnel");
const commitsByRepo = getCommitsByRepo(projects);
---

<Shell title="shevinum.dev">
  <Terminal
    client:load
    initialView="home"
    {site}
    {dashboard}
    {notifications}
    {tracker}
    {profile}
    {builds}
    {personnel}
    {companies}
    {grep}
    {help}
    {boot}
    {cmdline}
    {helpSearch}
    {shell}
    {projects}
    {personnelEntries}
    {commitsByRepo}
  />
</Shell>
