---
// Route: "/" — dashboard (home) view.
//
// All six route pages share this shape: one `loadTerminalProps()` call into
// src/bootstrap/loadAll.ts for the whole data bag, then SSR the
// Terminal.svelte island with `initialView` so the matching view is in the
// static HTML with no client-side flash; later view switches are
// client-side only (pushState).
import Layout from "../bootstrap/Layout.astro";
import Terminal from "../bootstrap/Terminal.svelte";
import { loadTerminalProps } from "../bootstrap/loadAll";

const props = await loadTerminalProps();
---

<Layout title="shevinum.dev">
  <Terminal client:load initialView="home" {...props} />
</Layout>
