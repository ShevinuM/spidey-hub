---
// Feature harness route: a fixture-build-only route that mounts one
// feature's top-level component with seeded fixture props, no Terminal
// kernel, isolating a feature's tests from the kernel entirely.
//
// Uses `Layout` directly, not `Terminal.svelte` — a declared exception to
// the usual "pages import only from bootstrap" convention, made so a
// harness spec can prove a feature works without the kernel present.
//
// `getStaticPaths` returns `[]` unless `PORTFOLIO_FIXTURES=1`, so a real
// build's `dist/` never carries any `harness/` output.
//
// Per-feature component + prop assembly lives here as a plain
// `feature === "<name>"` switch, one of the few places (with
// `bootstrap/Terminal.svelte`) allowed to know about every feature; a
// feature's content collection fixture-switches itself wherever its own
// loader calls for that, and `profile` isn't fixture-switched at all, so
// `getCollection("profile")` needs no extra handling here.
import Layout from "../../bootstrap/Layout.astro";
import Profile from "../../features/profile/components/Profile.svelte";
import HelpHarness from "../../features/help/tests/ui/harness/HelpHarness.svelte";
import BootSequence from "../../features/boot/components/BootSequence.svelte";
import NotificationsHarness from "../../features/notifications/tests/ui/harness/NotificationsHarness.svelte";
import DashboardHarness from "../../features/dashboard/tests/ui/harness/DashboardHarness.svelte";
import EmploymentHarness from "../../features/employment/tests/ui/harness/EmploymentHarness.svelte";
import RepositoriesHarness from "../../features/repositories/tests/ui/harness/RepositoriesHarness.svelte";
import GrepHarness from "../../features/grep/tests/ui/harness/GrepHarness.svelte";
import ShellFsHarness from "../../features/shell-fs/tests/ui/harness/ShellFsHarness.svelte";
import { getCollection } from "astro:content";
import { getCmdline } from "../../common/lib/data";
import { getCommitsByRepo } from "../../common/lib/commits";
import { buildProfile } from "../../features/profile/lib/data";
import { buildHelp, getHelpSearch } from "../../features/help/lib/data";
import { buildBoot } from "../../features/boot/lib/data";
import { buildNotifications } from "../../features/notifications/lib/data";
import { getShell } from "../../features/shell-fs/lib/data";
import { getDashboard } from "../../features/dashboard/lib/data";
import { getPersonnel } from "../../features/employment/lib/data";
import { getRepositories } from "../../features/repositories/lib/data";
import { getGrep } from "../../features/grep/lib/data";

export async function getStaticPaths() {
  if (process.env.PORTFOLIO_FIXTURES !== "1") return [];
  return [
    { params: { feature: "profile" } },
    { params: { feature: "help" } },
    { params: { feature: "boot" } },
    { params: { feature: "notifications" } },
    { params: { feature: "dashboard" } },
    { params: { feature: "employment" } },
    { params: { feature: "repositories" } },
    { params: { feature: "grep" } },
    { params: { feature: "shell-fs" } },
  ];
}

const { feature } = Astro.params;

const profile = feature === "profile" ? buildProfile((await getCollection("profile"))[0]) : undefined;
const help = feature === "help" ? buildHelp(await getCollection("help")) : undefined;
const helpSearch = feature === "help" ? getHelpSearch() : undefined;
const cmdline = feature === "help" ? getCmdline() : undefined;
const shell = feature === "help" ? getShell() : undefined;
const boot = feature === "boot" ? buildBoot(await getCollection("boot")) : undefined;
const notifications = feature === "notifications" ? buildNotifications(await getCollection("notifications")) : undefined;
const dashboard = feature === "dashboard" ? getDashboard() : undefined;
const personnel = feature === "employment" ? getPersonnel() : undefined;
const personnelEntries = feature === "employment" ? await getCollection("personnel") : undefined;
const repositories = feature === "repositories" ? getRepositories() : undefined;
const projects = feature === "repositories" ? await getCollection("repositories") : undefined;
const commitsByRepo = feature === "repositories" && projects ? getCommitsByRepo(projects) : undefined;
const grep = feature === "grep" ? getGrep() : undefined;
// Named `shellFs`, not `shell`, since `const shell` above already holds help's `getShell()` result.
const shellFs = feature === "shell-fs" ? getShell() : undefined;
---

<Layout title={`Harness: ${feature} — shevinum.dev`}>
  {
    feature === "profile" && profile !== undefined && (
      <Profile client:load profile={profile} isFocused={true} />
    )
  }
  {
    feature === "help" && help !== undefined && helpSearch !== undefined && cmdline !== undefined && shell !== undefined && (
      <HelpHarness client:load {help} {helpSearch} {cmdline} {shell} />
    )
  }
  {
    // Mounted directly (no wrapper): BootSequence is already boot's own
    // self-contained orchestrator, and this harness's assertions (mount,
    // phase/progress advancing under a driven clock, reaching "ready")
    // never need `onReady`/`bind:this`.
    //
    // `desktopMode={true}` is required:
    // BootSequence's own `$effect` no-ops without it.
    feature === "boot" && boot !== undefined && <BootSequence client:load {boot} desktopMode={true} />
  }
  {
    // Wrapped (not mounted directly): Notifications.svelte attaches no
    // keydown listener of its own — Terminal.svelte owns the window
    // listener and routes `n`/Esc into its exported `handleKey()`, which
    // NotificationsHarness reproduces — and hardcodes `fixtureMode={false}`
    // so its keydown/open-close assertions exercise live behavior rather
    // than the frozen golden-capture state `fixtureMode={true}` produces.
    feature === "notifications" && notifications !== undefined && <NotificationsHarness client:load {notifications} />
  }
  {
    // Wrapped despite Dashboard.svelte being a real, already-shipping
    // component PaneTree.svelte mounts directly elsewhere: the wrapper
    // supplies the onMount-flipped hydration-ready marker this `.astro`
    // frontmatter cannot express itself, plus the synthetic
    // isFocused/windowNumbers/paneCount/onSelect props a kernel-free mount
    // has no live tmux state to derive (see DashboardHarness's own header).
    feature === "dashboard" && dashboard !== undefined && <DashboardHarness client:load {dashboard} />
  }
  {
    // Wrapped for the same keydown-delegation reason as notifications
    // above.
    //
    // The `personnel` collection fixture-switches itself via
    // content.config.ts's own `base:` ternary, so no special handling is
    // needed here beyond the two data fetches above.
    feature === "employment" &&
      personnel !== undefined &&
      personnelEntries !== undefined && <EmploymentHarness client:load {personnel} {personnelEntries} />
  }
  {
    // Wrapped for the same keydown-delegation reason as notifications
    // above; `repositories` fixture-switches the same way `personnel`
    // does above.
    feature === "repositories" &&
      repositories !== undefined &&
      projects !== undefined &&
      commitsByRepo !== undefined && <RepositoriesHarness client:load {repositories} {projects} {commitsByRepo} />
  }
  {
    // Wrapped for the same keydown-delegation reason as notifications above
    // (see GrepHarness's own header for why `onNavigate` is a no-op here).
    //
    // Grep has no content collection — its yaml is a plain `?raw` data file
    // — so `getGrep()` alone is enough.
    feature === "grep" && grep !== undefined && <GrepHarness client:load {grep} />
  }
  {
    // Wrapped for the same keydown-delegation reason as notifications above
    // (see ShellFsHarness's own header for why it mounts PANE mode only).
    //
    // No content collection, same as grep above, so `getShell()` alone is
    // enough.
    feature === "shell-fs" && shellFs !== undefined && <ShellFsHarness client:load shell={shellFs} />
  }
</Layout>
