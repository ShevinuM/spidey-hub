---
// Feature harness route: a fixture-build-only route that mounts just ONE
// feature's own top-level component with seeded fixture props, no Terminal
// kernel, no tmux chrome. Isolates a feature's own tests from the kernel
// entirely — a failing `<feature>-harness` spec proves that feature itself
// is broken, independent of everything else.
//
// Uses `Layout` (global CSS/fonts + the mobile-block chrome every route
// page shares) directly, NOT `Terminal.svelte` — Terminal is the kernel
// composition itself (tmux engine, status bar, pane tree, window
// switching), which this route deliberately excludes. This makes the route
// a page importing a feature component directly rather than routing
// through `bootstrap/Terminal.svelte` — a declared exception to the usual
// "pages import only from bootstrap" convention, made specifically so a
// harness spec can prove a feature works without the kernel present at
// all.
//
// getStaticPaths returns [] unless PORTFOLIO_FIXTURES=1: in a real build
// this route generates ZERO pages, so `dist/` never carries any `harness/`
// output at all, not merely a hidden one — the fixture flag never leaks
// into a real build's output.
//
// Per-feature component + prop assembly lives in this one file as a small
// switch — each feature that adds its own harness spec adds a matching
// `feature === "<name>"` branch here (plain conditionals, not a
// registry/plugin system: most features still live in the legacy tree
// rather than their own bounded context, so there's no mechanism to
// discover features generically yet; this file is one of the few places
// still allowed to know about all of them, same as
// `bootstrap/Terminal.svelte`). A feature's content collection
// fixture-switches itself wherever its own loader calls for that;
// `profile` isn't fixture-switched at all (its content is identical in
// both build modes), so `getCollection("profile")` needs no extra handling
// here.
import Layout from "../../bootstrap/Layout.astro";
import Profile from "../../features/profile/components/Profile.svelte";
import HelpHarness from "../../features/help/tests/ui/harness/HelpHarness.svelte";
import { getCollection } from "astro:content";
import { buildProfile, buildHelp, getHelpSearch, getCmdline, getShell } from "../../common/lib/data";

export async function getStaticPaths() {
  if (process.env.PORTFOLIO_FIXTURES !== "1") return [];
  return [{ params: { feature: "profile" } }, { params: { feature: "help" } }];
}

const { feature } = Astro.params;

const profile = feature === "profile" ? buildProfile((await getCollection("profile"))[0]) : undefined;
const help = feature === "help" ? buildHelp(await getCollection("help")) : undefined;
const helpSearch = feature === "help" ? getHelpSearch() : undefined;
const cmdline = feature === "help" ? getCmdline() : undefined;
const shell = feature === "help" ? getShell() : undefined;
---

<Layout title={`Harness: ${feature} — shevinum.dev`}>
  {
    feature === "profile" && profile !== undefined && (
      <Profile client:load profile={profile} isFocused={true} />
    )
  }
  {
    feature === "help" && help !== undefined && helpSearch !== undefined && cmdline !== undefined && shell !== undefined && (
      <HelpHarness client:load {help} {helpSearch} {cmdline} {shell} />
    )
  }
</Layout>
