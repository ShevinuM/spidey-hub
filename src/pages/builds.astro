---
// Route: "/builds" — see src/pages/index.astro for the shared shape notes.
import Shell from "../layouts/Shell.astro";
import Terminal from "../components/Terminal.svelte";
import { getCollection } from "astro:content";
import { getSite, getDashboard, getNotifications, getTracker, getProfile, getBuilds, getPersonnel, getCompanies, getGrep, getHelp, getBoot, getCmdline, getHelpSearch, getShell, getChooseTree } from "../lib/data";
import { getCommitsByRepo } from "../lib/commits";

const site = getSite();
const dashboard = getDashboard();
const notifications = getNotifications();
const tracker = getTracker();
const profile = getProfile();
const builds = getBuilds();
const personnel = getPersonnel();
const companies = getCompanies();
const grep = getGrep();
const help = getHelp();
const boot = getBoot();
const cmdline = getCmdline();
const helpSearch = getHelpSearch();
const shell = getShell();
const chooseTree = getChooseTree();
const projects = await getCollection("projects");
const personnelEntries = await getCollection("personnel");
const commitsByRepo = getCommitsByRepo(projects);
// PORTFOLIO_FIXTURES gates the notification system into a fixed,
// hand-authored state for deterministic golden capture (Notifications.svelte's
// own header comment) — read server-side only, never client-side.
const notificationsFixtureMode = process.env.PORTFOLIO_FIXTURES === "1";
---

<Shell title="Builds — shevinum.dev">
  <Terminal
    client:load
    initialView="builds"
    {site}
    {dashboard}
    {notifications}
    {notificationsFixtureMode}
    {tracker}
    {profile}
    {builds}
    {personnel}
    {companies}
    {grep}
    {help}
    {boot}
    {cmdline}
    {helpSearch}
    {shell}
    {chooseTree}
    {projects}
    {personnelEntries}
    {commitsByRepo}
  />
</Shell>
