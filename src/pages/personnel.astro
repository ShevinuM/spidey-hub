---
// Route: "/personnel" — see src/pages/index.astro for the shared shape notes.
import Shell from "../layouts/Shell.astro";
import Terminal from "../components/Terminal.svelte";
import { getCollection } from "astro:content";
import { getSite, getDashboard, getTracker, getProfile, getBuilds, getPersonnel, getCompanies } from "../lib/data";

const site = getSite();
const dashboard = getDashboard();
const tracker = getTracker();
const profile = getProfile();
const builds = getBuilds();
const personnel = getPersonnel();
const companies = getCompanies();
const projects = await getCollection("projects");
const personnelEntries = await getCollection("personnel");
---

<Shell title="Personnel — shevinum.dev">
  <Terminal
    client:load
    initialView="personnel"
    {site}
    {dashboard}
    {tracker}
    {profile}
    {builds}
    {personnel}
    {companies}
    {projects}
    {personnelEntries}
  />
</Shell>
