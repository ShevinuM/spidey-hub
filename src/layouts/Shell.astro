---
// Minimal shell: fonts + global.css wired through the real Astro/Vite/
// Tailwind pipeline. Phase 3 replaces the body slot with Wallpaper +
// StatusBar + Terminal island; this stub exists only so `pnpm build`
// exercises the real pipeline in Phase 1.
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "shevinum.dev" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
