{
  "name": "shevinum-dev-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/generate.mjs",
    "build": "astro build",
    "build:fixtures": "PORTFOLIO_FIXTURES=1 astro build && cp fixtures/grep-index.json dist/generated/grep-index.json && cp fixtures/repos/all-projects.json dist/generated/repos/all-projects.json && cp fixtures/fs-index.json dist/generated/fs-index.json",
    "preview": "astro preview",
    "generate": "node scripts/generate.mjs",
    "check": "astro check && tsc --noEmit && svelte-check --threshold error",
    "goldens": "node tests/visual/capture-goldens.mjs",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:visual": "pnpm build:fixtures && playwright test tests/visual/identical.spec.ts",
    "test:e2e": "pnpm build && playwright test tests/e2e"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.2.2",
    "svelte": "5.56.9",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@shikijs/langs": "4.4.3",
    "@shikijs/types": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "material-file-icons": "2.4.0",
    "shiki": "4.4.3",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@11.20.0"
}
