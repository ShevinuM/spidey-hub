{
  "name": "shevinum-dev-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/generate.mjs",
    "build": "astro build",
    "build:fixtures": "PORTFOLIO_FIXTURES=1 astro build && cp src/features/grep/tests/ui/support/grep-index.json dist/generated/grep-index.json && cp src/features/repositories/tests/ui/support/repos/*.json dist/generated/repos/ && cp src/features/shell-fs/tests/ui/support/fs-index.json dist/generated/fs-index.json && cp src/features/repositories/tests/ui/support/contributions.json dist/generated/contributions.json",
    "preview": "astro preview",
    "generate": "node scripts/generate.mjs",
    "typecheck": "astro check && tsc --noEmit && svelte-check --threshold error",
    "check:arch": "vitest run tests/audits/boundaries.test.ts",
    "architecture": "pnpm check:arch && depcruise src --no-cache --output-type err-long",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "goldens": "node src/common/tests/ui/support/capture-goldens.mjs",
    "design-mirror": "node scripts/generate-design-mirror.mjs",
    "test:unit": "vitest run",
    "test:visual": "pnpm build:fixtures && E2E_EXPECT_FIXTURES=1 playwright test src/features/employment/tests/ui/visual/adversarial-fixtures.spec.ts src/features/repositories/tests/ui/visual/adversarial-fixtures.spec.ts src/common/tests/ui/visual/identical.spec.ts src/features/profile/tests/ui/visual/identical.spec.ts src/features/profile/tests/ui/harness/profile.spec.ts src/features/help/tests/ui/visual/identical.spec.ts src/features/help/tests/ui/harness/help.spec.ts src/features/boot/tests/ui/visual/identical.spec.ts src/features/boot/tests/ui/harness/boot.spec.ts src/features/notifications/tests/ui/visual/identical.spec.ts src/features/notifications/tests/ui/harness/notifications.spec.ts src/features/dashboard/tests/ui/visual/identical.spec.ts src/features/dashboard/tests/ui/harness/dashboard.spec.ts src/features/employment/tests/ui/visual/identical.spec.ts src/features/employment/tests/ui/harness/employment.spec.ts src/features/repositories/tests/ui/visual/identical.spec.ts src/features/repositories/tests/ui/harness/repositories.spec.ts src/features/grep/tests/ui/visual/identical.spec.ts src/features/grep/tests/ui/harness/grep.spec.ts src/features/shell-fs/tests/ui/visual/identical.spec.ts src/features/shell-fs/tests/ui/harness/shell-fs.spec.ts",
    "test:e2e": "pnpm build && E2E_EXPECT_FIXTURES=0 playwright test --project=smoke --project=common-1512x945 --project=common-1920x1080 --project=profile-1512x945 --project=profile-1920x1080 --project=help-1512x945 --project=help-1920x1080 --project=boot-1512x945 --project=boot-1920x1080 --project=notifications-1512x945 --project=notifications-1920x1080 --project=dashboard-1512x945 --project=dashboard-1920x1080 --project=employment-1512x945 --project=employment-1920x1080 --project=repositories-1512x945 --project=repositories-1920x1080 --project=grep-1512x945 --project=grep-1920x1080 --project=shell-fs-1512x945 --project=shell-fs-1920x1080"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.2.2",
    "svelte": "5.56.9",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@shikijs/langs": "4.4.3",
    "@shikijs/types": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.3.1",
    "material-file-icons": "2.4.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-svelte": "4.1.1",
    "shiki": "4.4.3",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
