[][]int","\tfor scanner.Scan() {","\t\tline := scanner.Text()","","\t\tif line == \"\" {","\t\t\tsection1 = false","\t\t\tcontinue","\t\t}","","\t\tif section1 {","\t\t\tparts := strings.Split(line, \"|\")","\t\t\tif len(parts) == 2 {","\t\t\t\tpage1, err1 := strconv.Atoi(parts[0])","\t\t\t\tpage2, err2 := strconv.Atoi(parts[1])","\t\t\t\tif err1 != nil || err2 != nil {","\t\t\t\t\tfmt.Println(\"error in converting pages to int\")","\t\t\t\t}","\t\t\t\tpageOrder[page1] = append(pageOrder[page1], page2)","\t\t\t\tpageOrderReverse[page2] = append(pageOrderReverse[page2], page1)","\t\t\t} else {","\t\t\t\tfmt.Println(\"Invalid Pages\")","\t\t\t}","\t\t} else {","\t\t\tparts := strings.Split(line, \",\")","\t\t\tvar pages []int","\t\t\tfor _, part := range parts {","\t\t\t\tpg, err := strconv.Atoi(part)","\t\t\t\tif err != nil {","\t\t\t\t\tfmt.Println(\"Error in input\")","\t\t\t\t}","\t\t\t\tpages = append(pages, pg)","\t\t\t}","\t\t\tpagesList = append(pagesList, pages)","\t\t}","\t}","\treturn pageOrder, pagesList, pageOrderReverse","}","","func check(pageOrder map[int][]int, update []int) (bool, int) {","\tfor i := 0; i < len(update); i++ {","\t\tval := update[i]","\t\tfor j := i; j < len(update); j++ {","\t\t\tval2 := update[j]","\t\t\tif postVals, exists := pageOrder[val2]; exists {","\t\t\t\tfor _, postVal := range postVals {","\t\t\t\t\tif postVal == val {","\t\t\t\t\t\treturn false, j","\t\t\t\t\t}","\t\t\t\t}","\t\t\t}","\t\t}","\t}","\treturn true, -1","}","","func sort(pageOrder map[int][]int, update []int, pageOrderReverse map[int][]int) []int {","\tfor i := 0; i < len(update); i++ {","\t\tval := update[i]","\t\tfor j := i + 1; j < len(update); j++ {","\t\t\tval2 := update[j]","\t\t\tif postVals, exists := pageOrder[val2]; exists {","\t\t\touterLoop:","\t\t\t\tfor _, postVal := range postVals {","\t\t\t\t\tif postVal == val {","\t\t\t\t\t\tfor i2 := 0; i2 < j; i2++ {","\t\t\t\t\t\t\tvalPro := update[i2]","\t\t\t\t\t\t\tif preVals, exists := pageOrderReverse[valPro]; exists {","\t\t\t\t\t\t\t\tfor _, preVal := range preVals {","\t\t\t\t\t\t\t\t\tif preVal == val2 {","\t\t\t\t\t\t\t\t\t\tremovedValue := update[j]","\t\t\t\t\t\t\t\t\t\tupdate = append(update[:j], update[j+1:]...)","\t\t\t\t\t\t\t\t\t\tupdate = append(update[:i2], append([]int{removedValue}, update[i2:]...)...)","\t\t\t\t\t\t\t\t\t\tbreak outerLoop","\t\t\t\t\t\t\t\t\t}","\t\t\t\t\t\t\t\t}","\t\t\t\t\t\t\t}","\t\t\t\t\t\t}","\t\t\t\t\t}","\t\t\t\t}","\t\t\t}","\t\t}","\t}","\treturn update","}","func part1(pageOrder map[int][]int, pages [][]int) int {","\tsum := 0","\tfor _, update := range pages {","\t\tvalid, index := check(pageOrder, update)","\t\tmiddleIndex := len(update) / 2","\t\tmiddleElement := update[middleIndex]","\t\tif valid || index == -1 {","\t\t\tsum += middleElement","\t\t}","\t}","\treturn sum","}","","func part2(pageOrder map[int][]int, pages [][]int, pageOrderReverse map[int][]int) int {","\tsum := 0","\tfor _, update := range pages {","\t\tvalid, _ := check(pageOrder, update)","\t\tmiddleIndex := len(update) / 2","\t\tif !valid {","\t\t\tnewUpdate := sort(pageOrder, update, pageOrderReverse)","\t\t\tmiddleElement := newUpdate[middleIndex]","\t\t\tsum += middleElement","\t\t}","\t}","\treturn sum","}","","func main() {","\tpageOrder, pagesList, pageOrderReverse := read(\"input2.txt\")","\tpart1 := part1(pageOrder, pagesList)","\tfmt.Println(part1)","\tpart2 := part2(pageOrder, pagesList, pageOrderReverse)","\tfmt.Println(part2)","}",""]},{"path":"Day6/benchmark.md","lines":["```","Part 1 : 0.015552 ms","Part 2 : 8.061213083 s","","goos: darwin","goarch: arm64","pkg: Day6","cpu: Apple M2","BenchmarkPart1-8           66414             15552 ns/op","BenchmarkPart2-8               1        8061213083 ns/op","PASS","```",""]},{"path":"Day6/day6_test.go","lines":["package main","","import (","    \"testing\"",")","","func BenchmarkPart1(b *testing.B) {","    parsedInput := parse(\"input2.txt\")","    for i := 0; i < b.N; i++ {","        part1(parsedInput)","    }","}","","func BenchmarkPart2(b *testing.B) {","    parsedInput := parse(\"input2.txt\")","    for i := 0; i < b.N; i++ {","        part2(parsedInput)","    }","}"]},{"path":"Day6/Day6.go","lines":["package main","","import (","\t\"bufio\"","\t\"fmt\"","\t\"github.com/deckarep/golang-set/v2\"","\t\"os\"",")","","type Coordinate struct {","\ty int","\tx int","\tval rune","}","","func parse(filename string) [][]rune {","\tfile, _ := os.Open(filename)","\tdefer file.Close()","\tscanner := bufio.NewScanner(file)","","\tvar matrix [][]rune","\tfor scanner.Scan() {","\t\tline := scanner.Text()","\t\tif line == \"\" {","\t\t\tcontinue","\t\t}","\t\tparts := []rune(line)","\t\tmatrix = append(matrix, parts)","\t}","","\treturn matrix","}","","func findStart(matrix [][]rune) (int, int) {","\tfor i := 0; i < len(matrix); i++ {","\t\tfor j := 0; j < len(matrix[0]); j++ {","\t\t\tcharacter := matrix[i][j]","\t\t\tif character == '^' || character == 'v' || character == '>' || character == '<' {","\t\t\t\treturn i, j","\t\t\t}","\t\t}","\t}","\treturn -1, -1","}","","func getMoveCoordinates(direction rune) []int {","\tswitch direction {","\tcase '^':","\t\treturn []int{-1, 0}","\tcase 'v':","\t\treturn []int{1, 0}","\tcase '>':","\t\treturn []int{0, 1}","\tcase '<':","\t\treturn []int{0, -1}","\tdefault:","\t\treturn []int{0, 0}","\t}","}","","func getNextDirection(curr rune) rune {","\tswitch curr {","\tcase '^':","\t\treturn '>'","\tcase 'v':","\t\treturn '<'","\tcase '>':","\t\treturn 'v'","\tcase '<':","\t\treturn '^'","\tdefault:","\t\treturn curr","\t}","}","","func part1(matrix [][]rune) int {","\ty, x := findStart(matrix)","\tif y == -1 || x == -1 {","\t\treturn -1","\t}","\tfinished := false","\tvisited := mapset.NewSet[Coordinate]()","\tcurrDirec := matrix[y][x]","\tmoveCoords := getMoveCoordinates(matrix[y][x])","\tfor !finished {","\t\tif y >= len(matrix) || y < 0 || x >= len(matrix[0]) || x < 0 {","\t\t\tfinished = true","\t\t\treturn visited.Cardinality()","\t\t}","\t\tif matrix[y][x] == '#' {","\t\t\ty = y - moveCoords[0]","\t\t\tx = x - moveCoords[1]","\t\t\tnextDir := getNextDirection(currDirec)","\t\t\tcurrDirec = nextDir","\t\t\tmoveCoords = getMoveCoordinates(currDirec)","\t\t}","\t\tcoord := Coordinate{y: y, x: x, val: '?'}","\t\tmatrix[y][x] = 'X'","\t\tvisited.Add(coord)","\t\ty = y + moveCoords[0]","\t\tx = x + moveCoords[1]","\t}","\treturn visited.Cardinality()","}","","func copyMatrix(matrix [][]rune) [][]rune {","\tmatrixCopy := make([][]rune, len(matrix))","\tfor i := range matrix {","\t\t\tmatrixCopy[i] = make([]rune, len(matrix[i]))","\t\t\tcopy(matrixCopy[i], matrix[i])","\t}","\treturn matrixCopy","}","","func part2(matrix [][]rune) int {","\tsum := 0","\tfor i := 0; i < len(matrix); i++ {","\t\tfor j := 0; j < len(matrix[0]); j++ {","\t\t\tcharacter := matrix[i][j]","\t\t\tif character != '#' && character != '^' && character != 'v' && character != '>' && character != '<' {","\t\t\t\tmatrix[i][j] = '#'","\t\t\t\tisloop := isLoop(copyMatrix(matrix))","\t\t\t\tif isloop {","\t\t\t\t\tsum = sum + 1","\t\t\t\t}","\t\t\t\tmatrix[i][j] = '.'","\t\t\t}","\t\t}","\t}","\treturn sum","}","","func isLoop(matrix [][]rune) bool {","\ty, x := findStart(matrix)","\tif y == -1 || x == -1 {","\t\treturn false","\t}","\tvisited := mapset.NewSet[Coordinate]() ","\tmoveCoords := getMoveCoordinates(matrix[y][x])","\tcurrDirec := matrix[y][x]","\tfor y >= 0 && y < len(matrix) && x >= 0 && x < len(matrix[0]) {","\t\tcoord := Coordinate{y: y, x: x, val: currDirec}","\t\tif matrix[y][x] == '#' {","\t\t\ty = y - moveCoords[0]","\t\t\tx = x - moveCoords[1]","\t\t\tnextDir := getNextDirection(currDirec)","\t\t\tcurrDirec = nextDir","\t\t\tmoveCoords = getMoveCoordinates(currDirec)","\t\t\tcoord = Coordinate{y: y, x: x, val: currDirec}","\t\t}","\t\tif visited.Contains(coord) {","\t\t\treturn true","\t\t}","\t\tvisited.Add(coord)","\t\tmatrix[y][x] = 'X'","\t\ty = y + moveCoords[0]","\t\tx = x + moveCoords[1]","","\t}","\treturn false","}","","func main() {","\tparsedInput := parse(\"input2.txt\")","\tpart1 := part1(copyMatrix(parsedInput))","\tfmt.Println(part1)","\tpart2 := part2(copyMatrix(parsedInput))","\tfmt.Println(part2)","}",""]},{"path":"Day7/benchmark.md","lines":["```","Part1 : 7.98267 ms","Part2 : 243.788475 ms","","goos: darwin","goarch: arm64","pkg: Day7","cpu: Apple M2","BenchmarkPart1-8             148           7982670 ns/op","BenchmarkPart2-8               5         243788475 ns/op","PASS","```",""]},{"path":"Day7/day7_test.go","lines":["package main","","import (","\t\"testing\"",")","","func BenchmarkPart1(b *testing.B) {","\tparsedInput, _ := parse(\"input2.txt\")","\tfor i := 0; i < b.N; i++ {","\t\tpart1(parsedInput)","\t}","}","","func BenchmarkPart2(b *testing.B) {","\tparsedInput, _ := parse(\"input2.txt\")","\tfor i := 0; i < b.N; i++ {","\t\tpart2(parsedInput)","\t}","}"]},{"path":"Day7/Day7.go","lines":["package main","","import (","\t\"bufio\"","\t\"errors\"","\t\"fmt\"","\t\"io\"","\t\"os\"","\t\"strconv\"","\t\"strings\"",")","","func parse(filename string) (map[int]map[int][]int, error) {","\tequations := make(map[int]map[int][]int)","\tfile, err := os.Open(filename)","\tif err != nil {","\t\treturn nil, err","\t}","\tdefer file.Close()","\tr := bufio.NewReader(file)","\teof := false","\tcount := 0","\tfor {","\t\tline, err := r.ReadString('\\n')","\t\tif err != nil && err != io.EOF {","\t\t\treturn nil, err","\t\t}","\t\tif err == io.EOF {","\t\t\teof = true","\t\t}","\t\tequation := strings.Split(line, \":\")","\t\tif len(equation) != 2 {","\t\t\treturn nil, errors.New(\"Length of equation array not 2\")","\t\t}","\t\tnumsStr := strings.Fields(equation[1])","\t\tnums := make([]int, len(numsStr))","\t\tfor i, num := range numsStr {","\t\t\tnums[i], err = strconv.Atoi(num)","\t\t\tif err != nil {","\t\t\t\treturn nil, err","\t\t\t}","\t\t}","\t\ttestVal, err := strconv.Atoi(equation[0])","\t\tif err != nil {","\t\t\treturn nil, err","\t\t}","\t\tif equations[count] == nil {","\t\t\tequations[count] = make(map[int][]int)","\t\t}","\t\tequations[count][testVal] = nums","\t\tcount += 1","\t\tif eof {","\t\t\tbreak","\t\t}","\t}","\treturn equations, nil","}","","func calc(vals []int, operator rune, currSum int, targetSum int) bool {","\tif len(vals) == 0 {","\t\treturn currSum == targetSum","\t}","\tif currSum > targetSum {","\t\treturn false","\t}","\tx, vals := vals[0], vals[1:]","\tif operator == '+' {","\t\tcurrSum += x","\t} else {","\t\tcurrSum *= x","\t}","\treturn calc(append([]int(nil), vals...), '+', currSum, targetSum) || calc(append([]int(nil), vals...), '*', currSum, targetSum)","}","","func getConcatVal(currSum int, x int) int {","\tmul := 1","\tfor temp := x; temp > 0; temp /= 10 {","\t\tmul *= 10","\t}","\treturn currSum * mul + x","}","","func calc2(vals []int, operator rune, currSum int, targetSum int) bool {","\tif len(vals) == 0 {","\t\treturn currSum == targetSum","\t}","\tif currSum > targetSum {","\t\treturn false","\t}","\tx, vals := vals[0], vals[1:]","\tif operator == '+' {","\t\tcurrSum += x","\t} else if operator == '|' {","\t\tcurrSum = getConcatVal(currSum, x)","\t} else {","\t\tcurrSum *= x","\t}","\treturn calc2(append([]int(nil), vals...), '+', currSum, targetSum) || calc2(append([]int(nil), vals...), '*', currSum, targetSum) || calc2(append([]int(nil), vals...), '|', currSum, targetSum)","}","","func part2(input map[int]map[int][]int) int {","\tsum := 0","\tfor _, val := range input {","\t\tfor testVal, numbers := range val {","\t\t\tisValid := calc2(append([]int(nil), numbers[1:]...), '+', numbers[0], testVal) || calc2(append([]int(nil), numbers[1:]...), '*', numbers[0], testVal) || calc2(append([]int(nil), numbers[1:]...), '|', numbers[0], testVal)","\t\t\tif isValid {","\t\t\t\tsum += testVal","\t\t\t}","\t\t}","\t}","\treturn sum","}","","func part1(input map[int]map[int][]int) int {","\tsum := 0","\tfor _, val := range input {","\t\tfor testVal, numbers := range val {","\t\t\tisValid := calc(append([]int(nil), numbers[1:]...), '+', numbers[0], testVal) || calc(append([]int(nil), numbers[1:]...), '*', numbers[0], testVal)","\t\t\tif isValid {","\t\t\t\tsum += testVal","\t\t\t}","\t\t}","\t}","\treturn sum","}","","func main() {","\tparsedInput, err := parse(\"input2.txt\")","\tif err != nil {","\t\tfmt.Println(err)","\t\treturn","\t}","\tpart1 := part1(parsedInput)","\tfmt.Println(\"Part 1 : \", part1)","\tpart2 := part2(parsedInput)","\tfmt.Println(\"Part 2 : \", part2)","}",""]},{"path":"Day8/benchmark.md","lines":["```","Part 1 : 0.034177 ms","Part 2 : 0.095859 ms","","goos: darwin","goarch: arm64","pkg: Day8","cpu: Apple M2","BenchmarkPart1-8           33192             34177 ns/op","BenchmarkPart2-8           12536             95859 ns/op","PASS","```",""]},{"path":"Day8/day8_test.go","lines":["package main","","import (","    \"testing\"",")","","func BenchmarkPart1(b *testing.B) {","    cMap, maxCoord, _:= parse(\"input2.txt\")","    for i := 0; i < b.N; i++ {","        sol(cMap, maxCoord, 1)","    }","}","","func BenchmarkPart2(b *testing.B) {","    cMap, maxCoord, _:= parse(\"input2.txt\")","    for i := 0; i < b.N; i++ {","        sol(cMap, maxCoord, 2)","    }","}",""]},{"path":"Day8/Day8.go","lines":["package main","","import (","\t\"bufio\"","\t\"fmt\"","\t\"os\"","\t\"unicode\"","\t\"gonum.org/v1/gonum/stat/combin\"",")","","type Coordinate struct {","\ty int","\tx int","}","","type Set map[Coordinate]struct{}","","func isAlphaNumeric(c rune) bool {","\treturn unicode.IsLetter(c) || unicode.IsDigit(c)","}","","func parse(filename string) (map[rune][]Coordinate, Coordinate, error) {","\tcoordinateMap := make(map[rune][]Coordinate)","\tfile, err := os.Open(filename)","\tif err != nil {","\t\treturn nil, Coordinate{y: -1, x: -1}, err","\t}","\tdefer file.Close()","\tscanner := bufio.NewScanner(file)","\tvar maxX int","\tvar maxY int","\ty := 0","\tfor scanner.Scan() {","\t\tline := scanner.Text()","\t\tparts := []rune(line)","\t\tmaxX = len(parts) - 1","\t\tfor x := 0; x < len(parts); x++ {","\t\t\tc := parts[x]","\t\t\tif isAlphaNumeric(c) {","\t\t\t\tif _, exists := coordinateMap[c]; exists {","\t\t\t\t\tcoordinateMap[c] = append(coordinateMap[c], Coordinate{y: y, x: x})","\t\t\t\t} else {","\t\t\t\t\tcoordinateMap[c] = []Coordinate{Coordinate{y: y, x: x}}","\t\t\t\t}","\t\t\t}","\t\t}","\t\ty += 1","\t}","\tmaxY = y - 1","\treturn coordinateMap, Coordinate{y: maxY, x: maxX}, nil","}","","func isWithinBounds(coord Coordinate, maxCoord Coordinate, minCoord Coordinate) bool{","\treturn coord.y >= minCoord.y && coord.y <= maxCoord.y && coord.x >= minCoord.x && coord.x <= maxCoord.x","}","","func sol(cMap map[rune][]Coordinate, maxCoord Coordinate, part int) int {","\tminCoord := Coordinate{y: 0, x: 0}","\tantinodes := make(Set) ","\tfor _, coords := range cMap {","\t\tcombs := combin.Combinations(len(coords), 2)","\t\tfor _, comb := range combs {","\t\t\tvar combi []Coordinate","\t\t\tfor _, index := range comb {","\t\t\t\tcombi = append(combi, coords[index])","\t\t\t}","\t\t\tyDiff := combi[1].y - combi[0].y","\t\t\txDiff := combi[1].x - combi[0].x","\t\t\tantiNode1 := Coordinate{y: combi[1].y + yDiff, x: combi[1].x + xDiff}","\t\t\tif isWithinBounds(antiNode1, maxCoord, minCoord) {","\t\t\t\t\tantinodes[antiNode1] = struct{}{}","\t\t\t}","\t\t\tantiNode2 := Coordinate{y: combi[0].y - yDiff, x: combi[0].x - xDiff}","\t\t\tif isWithinBounds(antiNode2, maxCoord, minCoord) {","\t\t\t\t\tantinodes[antiNode2] = struct{}{}","\t\t\t}","\t\t\tif part == 2 {","\t\t\t\tantiNode3 := Coordinate{y: combi[1].y - yDiff, x: combi[1].x - xDiff}","\t\t\t\tfor isWithinBounds(antiNode3, maxCoord, minCoord) {","\t\t\t\t\tantinodes[antiNode3] = struct{}{}","\t\t\t\t\tantiNode3 = Coordinate{y: antiNode3.y - yDiff, x: antiNode3.x - xDiff}","\t\t\t\t}","\t\t\t\tantiNode4 := Coordinate{y: combi[0].y + yDiff, x: combi[0].x + xDiff}","\t\t\t\tfor isWithinBounds(antiNode4, maxCoord, minCoord) {","\t\t\t\t\tantinodes[antiNode4] = struct{}{}","\t\t\t\t\tantiNode4 = Coordinate{y: antiNode4.y + yDiff, x: antiNode4.x + xDiff}","\t\t\t\t}","\t\t\t}","\t\t}","\t}","\treturn len(antinodes)","}","","func main() {","\tcMap, maxCoord, err := parse(\"input2.txt\")","\tif err != nil {","\t\tfmt.Println(err)","\t\treturn","\t}","\tpart1 := sol(cMap, maxCoord, 1)","\tfmt.Println(\"Part 1 -> \", part1)","\tpart2 := sol(cMap, maxCoord, 2)","\tfmt.Println(\"Part 2 -> \", part2)","}",""]},{"path":"Day9/benchmark.md","lines":["```","Part 1 : 0.069153 ms","Part 2 : 352.929931 ms","","goos: darwin","goarch: arm64","pkg: Day9","cpu: Apple M2","BenchmarkPart1-8    16539   69153 ns/op","BenchmarkPart2-8        3   352929931 ns/op","PASS","```",""]},{"path":"Day9/day9_test.go","lines":["package main","","import (","    \"testing\"",")","","func BenchmarkPart1(b *testing.B) {","    parsedInp, _ := parse(\"input2.txt\")","    for i := 0; i < b.N; i++ {","        part1(parsedInp)","    }","}","","func BenchmarkPart2(b *testing.B) {","    parsedInp, _ := parse(\"input2.txt\")","    for i := 0; i < b.N; i++ {","        part2(parsedInp)","    }","}"]},{"path":"Day9/Day9.go","lines":["package main","","import (","\t\"bufio\"","\t\"fmt\"","\t\"os\"",")","","func parse(fileName string) ([]int, error) {","\tvar parsedInput []int","\tfile, err := os.Open(fileName)","\tif err != nil {","\t\treturn nil, err","\t}","\tdefer file.Close()","\tscanner := bufio.NewScanner(file)","\tif scanner.Scan() {","\t\tline := scanner.Text()","\t\tintLine := make([]int, len(line))","\t\tfor i, char := range line {","\t\t\tintLine[i] = int(char - '0')","\t\t}","\t\tfilePointer, freePointer := 0, 1","\t\tfileId := 0","\t\tlenLine := len(intLine)","\t\tfor filePointer < lenLine || freePointer < lenLine {","\t\t\tfor i := 0; filePointer < lenLine && i < intLine[filePointer]; i++ {","\t\t\t\tparsedInput = append(parsedInput, fileId)","\t\t\t}","\t\t\tfor i := 0; freePointer < lenLine && i < intLine[freePointer]; i++ {","\t\t\t\tparsedInput = append(parsedInput, -1)","\t\t\t}","\t\t\tfilePointer += 2","\t\t\tfreePointer += 2","\t\t\tfileId += 1","\t\t}","\t}","\treturn parsedInput, nil","}","","func checkSum(input []int) int {","\tcheckSum := 0","\tfor i := 0; i < len(input); i++ {","\t\tif input[i] != -1 {","\t\t\tcheckSum += i * input[i]","\t\t}","\t}","\treturn checkSum","}","","func part2(input []int) int {","\tlenInput := len(input)","\tleft, rightLeft, rightRight := 0, lenInput - 1, lenInput - 1","\tfor left < rightLeft {","\t\tfor left < rightLeft && input[left] != -1 {","\t\t\tleft += 1","\t\t}","\t\tfor rightRight > left && input[rightRight] == -1 {","\t\t\trightRight--","\t\t}","\t\trightLeft = rightRight","\t\tfor rightLeft-1 > left && input[rightLeft-1] == input[rightRight] {","\t\t\trightLeft--","\t\t}","\t\twindowLength := rightRight - rightLeft","\t\tswapped := false","\t\tfor left < rightLeft && !swapped {","\t\t\tspaceAvailable := true","\t\t\tfor i := left; i <= left + windowLength; i++ {","\t\t\t\tif input[i] != -1 {","\t\t\t\t\tspaceAvailable = false","\t\t\t\t\tbreak","\t\t\t\t}","\t\t\t}","\t\t\tif spaceAvailable {","\t\t\t\tfor i := 0 ; i <= windowLength ; i++ {","\t\t\t\t\tinput[left + i], input[rightRight - i] = input[rightRight - i], input[left + i]","\t\t\t\t}","\t\t\t\tswapped = true","\t\t\t} else {","\t\t\t\tleft++","\t\t\t\tfor left < rightLeft && input[left] != -1 {","\t\t\t\t\tleft++","\t\t\t\t}","\t\t\t}","\t\t}","\t\trightRight, rightLeft = rightLeft - 1, rightLeft - 1","\t\tleft = 0","\t}","\treturn checkSum(input)","}","","func part1(input []int) int {","\tleft := 0","\tright := len(input) - 1","\tfor left < right {","\t\tfor left < len(input) && input[left] != -1 {","\t\t\tleft += 1","\t\t}","\t\tfor right >= 0 && input[right] == -1 {","\t\t\tright -= 1","\t\t}","\t\tif left < right {","\t\t\tinput[left], input[right] = input[right], input[left]","\t\t\tleft++","\t\t\tright--","\t\t}","\t}","\treturn checkSum(input)","}","","func main() {","\tparsedInp, err := parse(\"input2.txt\")","\tif err != nil {","\t\treturn","\t}","\tpart1 := part1(append([]int(nil), parsedInp...))","\tfmt.Println(\"Part 1 : \", part1)","\tpart2 := part2(append([]int(nil), parsedInp...))","\tfmt.Println(\"Part 2 : \", part2)","}",""]}]}
